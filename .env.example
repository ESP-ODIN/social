# cmd/api loads .env; existing process environment takes precedence.
HTTP_ADDR=127.0.0.1:8081
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
AUTH_JWKS_URL=http://localhost:8080/.well-known/jwks.json
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=odin-api
# Docker env-files: do not surround values with quotes.
